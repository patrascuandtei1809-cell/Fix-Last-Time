+            _mexc_age = int(time.time() - int(_mexc.get("updated_at", 0) or 0))
+            st.metric("MEXC USDT", f"{_mexc_usdt:.2f}", "LIVE" if _mexc_can_trade else "NO TRADE")
+            st.caption(f"MEXC balance updated {_mexc_age}s ago")
+        else:
+            st.caption("MEXC balance: not loaded yet")
