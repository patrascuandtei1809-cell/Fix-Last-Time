[Unit]
Description=AlphaTrade read-only FastAPI dashboard API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-bot-clean/trading
Environment=PYTHONUNBUFFERED=1
Environment=ALPHATRADE_API_PORT=8000
ExecStart=/root/trading-bot-clean/venv/bin/uvicorn api_server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

# Read-only API — no trading secrets required in environment.
# Exchange credentials remain in data/.binance_creds.json etc. (unused by this service).

[Install]
WantedBy=multi-user.target
